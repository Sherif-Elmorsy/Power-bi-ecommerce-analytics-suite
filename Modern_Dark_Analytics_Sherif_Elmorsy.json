{
  "name": "Modern Dark Analytics - Sherif Elmorsy",
  "dataColors": [
    "#1677FF",
    "#00C781",
    "#8B3DFF",
    "#FF9800",
    "#FF2D3F",
    "#45B6FE",
    "#6F7BF7",
    "#22C55E",
    "#F97316",
    "#A855F7"
  ],
  "background": "#0B1220",
  "foreground": "#F8FAFC",
  "tableAccent": "#1677FF",
  "good": "#00C781",
  "neutral": "#FF9800",
  "bad": "#FF2D3F",
  "maximum": "#1677FF",
  "center": "#6F7BF7",
  "minimum": "#1E293B",
  "null": "#64748B",
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#121C31"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#2A3957"
              }
            },
            "radius": 12
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#F8FAFC"
              }
            },
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold",
            "alignment": "left"
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "general": [
          {
            "keepLayerOrder": true,
            "altText": ""
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#0B1220"
              }
            },
            "transparency": 0
          }
